{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.p3pp3rf1y.sophisticatedbackpacks.fabric.FabricSophisticatedBackpacks"
    ],
    "client": [
      "net.p3pp3rf1y.sophisticatedbackpacks.fabric.FabricSophisticatedBackpacksClient"
    ],
    "jei_mod_plugin": [
      "net.p3pp3rf1y.sophisticatedbackpacks.compat.recipeviewers.jei.BackpackJeiPlugin"
    ]
  },
  "mixins": [
    "sophisticatedbackpacks.mixins.json"
  ],
  "accessWidener": "sophisticatedbackpacks.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "sophisticatedcore": "*"
  },
  "suggests": {
    "jei": "*",
    "trinkets": "*"
  }
}
